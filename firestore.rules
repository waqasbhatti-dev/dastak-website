rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // New public submissions must have status == 'pending' so users cannot self-approve reviews
    function isValidPendingFeedback(data) {
      return data.keys().hasAll(['rating', 'comment', 'status', 'createdAt'])
        && data.keys().hasOnly(['rating', 'comment', 'status', 'createdAt', 'displayName', 'category'])
        && (data.rating is int || data.rating is number)
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() >= 5
        && data.comment.size() <= 1000
        && data.status is string
        && data.status == 'pending'
        && data.createdAt == request.time
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    match /feedback/{feedbackId} {
      // Public reading of approved customer feedback only
      allow get: if isValidId(feedbackId) && resource.data.status == 'approved';
      allow list: if resource.data.status == 'approved';

      // Public submission creates pending feedback with strict schema & boundary enforcement
      allow create: if isValidId(feedbackId) && isValidPendingFeedback(incoming());

      // Immutable: users cannot approve their own reviews, modify ratings, or delete records
      allow update, delete: if false;
    }
  }
}
